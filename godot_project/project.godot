; Engine configuration file for Krystal-Stack Holographic Godot Engine
; Packaging: Godot 4.2+ Forward+ / Compatibility

config_version=5

[application]

config/name="Krystal Holographic Neural Compositor"
config/description="Godot 4.x 3D Volumetric ASCII Hologram and G-Buffer Extraction Bridge"
config/version="1.0.0"
run/main_scene="res://scenes/HoloStage.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1.0)
