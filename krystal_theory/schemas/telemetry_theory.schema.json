{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telemetry_theory.schema.json",
  "title": "Teória o telemetrii ako diagnostickom nástroji",
  "description": "Koreňový dokument: signály → hypotézy → verdikty → odvodené ciele. Skladá sa zo schém telemetry_signal, diagnostic_hypothesis a diagnostic_verdict. Validuje sa stdlib validátorom krystal_kernel/rails/schema_validate.py (podmnožina draft 2020-12).",
  "type": "object",
  "required": ["theory", "version", "title", "scope", "theory_refs", "signals", "hypotheses", "verdicts", "last_checked"],
  "additionalProperties": false,
  "properties": {
    "theory": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 3},
    "scope": {"type": "string", "minLength": 3},
    "theory_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "signals": {"type": "array", "minItems": 1, "items": {"$ref": "telemetry_signal.schema.json"}},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "diagnostic_hypothesis.schema.json"}},
    "verdicts": {"type": "array", "items": {"$ref": "diagnostic_verdict.schema.json"}},
    "derived_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^G[0-9]+$"},
          "text": {"type": "string", "minLength": 3},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "last_checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
