#version 450
// CrystalSec taxonomy kernel: BRANCH_HEAVY_CONTROL
// Same data-dependent if-chain as T0, so SIMT divergence is real, not modelled.
// T0: k%11==0 -> 3k+1 ; k%7==0 -> k//2 ; k%3==0 -> 5k ; k%2==0 -> k+17 ; else k-1
// Keys are non-negative (< 1024), so integer division matches Python floor division.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Params { uint n; uint stride; uint aux0; uint aux1; float c[4]; } p;
layout(std430, binding = 1) readonly buffer A { int keys[]; };
layout(std430, binding = 2) readonly buffer B { float unused_b[]; };
layout(std430, binding = 3) writeonly buffer Out { float o[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    int k = keys[i];
    int v;
    if (k % 11 == 0) {
        v = k * 3 + 1;
    } else if (k % 7 == 0) {
        v = k / 2;
    } else if (k % 3 == 0) {
        v = k * 5;
    } else if (k % 2 == 0) {
        v = k + 17;
    } else {
        v = k - 1;
    }
    o[i] = float(v);
}
