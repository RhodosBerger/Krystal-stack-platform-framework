#version 450
// CrystalSec taxonomy kernel: FP32_VECTOR_MATH
// Semantics equal T0: out[i] = c0 + c1*x + c2*x^2 + c3*x^3  (T0 uses float64; tolerance-verified).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Params { uint n; uint stride; uint aux0; uint aux1; float c[4]; } p;
layout(std430, binding = 1) readonly buffer A { float x_in[]; };
layout(std430, binding = 2) readonly buffer B { float unused_b[]; };
layout(std430, binding = 3) writeonly buffer Out { float o[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float x = x_in[i];
    o[i] = p.c[0] + p.c[1] * x + p.c[2] * (x * x) + p.c[3] * (x * x * x);
}
