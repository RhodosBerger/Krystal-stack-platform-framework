{
  "rail": "hr1_threshold_switching",
  "version": 1,
  "description": "H-R1 on synthetic iid noise around the threshold: observed switch rate vs Theorem 3.1 prediction 2p(1-p) with the Lemma 5.2 standard error, plus the |rho1| <= 0.2 criterion. Expected verdict on iid data: NOT_REJECTED.",
  "theory_ref": "Veta 3.1, H-R1, Lema 5.2",
  "nodes": [
    {"id": "src", "fn": "source.synthetic_series", "label": "theta (iid gaussian)",
     "params": {"n": 20000, "mean": 85.0, "noise": "gaussian", "amplitude": 2.0, "seed": 7}},
    {"id": "mode", "fn": "transform.threshold_mode", "label": "q = 1[theta >= 85]", "params": {"threshold": 85.0}},
    {"id": "p", "fn": "measure.exceed_fraction"},
    {"id": "s", "fn": "measure.switch_rate"},
    {"id": "pred", "fn": "measure.expected_switch_rate", "label": "2p(1-p)"},
    {"id": "sig", "fn": "measure.iid_switch_sigma"},
    {"id": "cmp", "fn": "diagnose.compare_prediction",
     "params": {"z": 1.96, "claim": "s_hat lies within 1.96 sigma of 2p(1-p)"}},
    {"id": "rho", "fn": "measure.lag1_autocorr"},
    {"id": "rho_chk", "fn": "diagnose.bound_check",
     "params": {"upper": 0.2, "absolute": true, "claim": "|rho1| <= 0.2"}},
    {"id": "verdict", "fn": "diagnose.combine_verdicts",
     "params": {"claim": "H-R1: threshold samples behave as iid (Theorem 3.1 applies)"}}
  ],
  "links": [
    {"from": "src.series", "to": "mode.series"},
    {"from": "mode.modes", "to": "p.modes"},
    {"from": "mode.modes", "to": "s.modes"},
    {"from": "p.p", "to": "pred.p"},
    {"from": "p.p", "to": "sig.p"},
    {"from": "s.pairs", "to": "sig.pairs"},
    {"from": "s.rate", "to": "cmp.observed"},
    {"from": "pred.rate", "to": "cmp.predicted"},
    {"from": "sig.sigma", "to": "cmp.sigma"},
    {"from": "mode.modes", "to": "rho.series"},
    {"from": "rho.rho", "to": "rho_chk.value"},
    {"from": "cmp.verdict", "to": "verdict.a"},
    {"from": "rho_chk.verdict", "to": "verdict.b"}
  ],
  "outputs": ["p.p", "s.rate", "pred.rate", "sig.sigma", "rho.rho", "verdict.verdict"]
}
