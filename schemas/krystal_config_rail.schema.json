{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krystal_config_rail.schema.json",
  "title": "Krystal configuration rail",
  "description": "Declarative graph of node functions. Source of truth: krystal_kernel/rails/rail.py (RAIL_SCHEMA).",
  "type": "object",
  "required": [
    "rail",
    "version",
    "nodes",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "rail": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "theory_ref": {
      "type": "string",
      "maxLength": 200
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fn"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "fn": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z0-9_]+$"
          },
          "params": {
            "type": "object"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"
      }
    }
  }
}
