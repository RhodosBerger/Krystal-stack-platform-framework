{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hte001RunManifestSchema",
  "description": "JSON Schema governing KSL v0.2 Hardware Transition Experiment 001 Preregistered Run Manifest",
  "type": "object",
  "required": [
    "experiment_id",
    "run_series_id",
    "preregistration_status",
    "preregistration_timestamp",
    "software_commit",
    "acquisition_harness_hash",
    "transition_oracle_hash",
    "sensor_contract_hash",
    "requirements_lock_hash",
    "acquisition_software_identity",
    "fpga_part",
    "board_model",
    "clock_frequency_hz",
    "sampling_rate_hz",
    "epsilon_latency",
    "epsilon_energy",
    "epsilon_thermal",
    "epsilon_memory",
    "epsilon_queue",
    "exact_zero_mode",
    "exact_zero_invariant_fields",
    "normalized_tolerance_fields",
    "minimum_runs",
    "statistical_criterion"
  ],
  "properties": {
    "experiment_id": { "type": "string", "const": "HTE-001" },
    "run_series_id": { "type": "string" },
    "preregistration_status": { "type": "string", "enum": ["FINAL_PREREGISTERED_MANIFEST", "DRAFT", "SUPERSEDED"] },
    "supersedes_manifest_hash": { "type": ["string", "null"] },
    "superseded_reason": { "type": ["string", "null"] },
    "preregistration_timestamp": { "type": "string", "format": "date-time" },
    "first_physical_sample_timestamp": { "type": ["string", "null"] },
    "software_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "acquisition_harness_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "transition_oracle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sensor_contract_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requirements_lock_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acquisition_software_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "independent_sample_method": { "type": "string" },
    "ksl_source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kir_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kmicroisa_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rtl_source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bitstream_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fpga_part": { "type": "string" },
    "board_model": { "type": "string" },
    "board_serial_or_alias": { "type": "string" },
    "clock_frequency_hz": { "type": "integer", "minimum": 1 },
    "clock_domain": { "type": "string" },
    "input_vector_hash": { "type": "string" },
    "policy_hash": { "type": "string" },
    "invariant_set_hash": { "type": "string" },
    "measurement_boundary": { "type": "string" },
    "power_sensor": { "type": "string" },
    "sampling_rate_hz": { "type": "integer", "minimum": 1 },
    "calibration_hash": { "type": "string" },
    "epsilon_latency": { "type": "number", "minimum": 0 },
    "epsilon_energy": { "type": "number", "minimum": 0 },
    "epsilon_thermal": { "type": "number", "minimum": 0 },
    "epsilon_memory": { "type": "number", "const": 0.0 },
    "epsilon_queue": { "type": "number", "minimum": 0 },
    "epsilon_energy_semantics": { "type": "string" },
    "epsilon_memory_semantics": { "type": "string" },
    "exact_zero_mode": { "type": "string", "const": "EXACT" },
    "exact_zero_epsilon": { "type": "number", "const": 0.0 },
    "exact_zero_invariant_fields": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "memory" }
    },
    "normalized_tolerance_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operations_per_run": { "type": "integer", "minimum": 1 },
    "logical_batch_size": { "type": "integer", "minimum": 1 },
    "measurement_duration_min_ms": { "type": "number", "minimum": 0 },
    "idle_pairing_protocol": { "type": "string" },
    "idle_window_duration_ms": { "type": "number", "minimum": 0 },
    "randomization_seed": { "type": "integer" },
    "minimum_runs": { "type": "integer", "minimum": 30 },
    "statistical_criterion": {
      "type": "object",
      "required": [
        "bootstrap_iterations",
        "ci_confidence_level",
        "evaluator",
        "max_allowed_ci_upper_bound_norm_residual",
        "max_exact_residual_violations",
        "min_acquisition_valid_runs",
        "min_allowed_ci_lower_bound_norm_residual"
      ],
      "properties": {
        "bootstrap_iterations": { "type": "integer", "minimum": 100 },
        "ci_confidence_level": { "type": "number", "minimum": 0.90, "maximum": 0.999 },
        "evaluator": { "type": "string" },
        "max_allowed_ci_upper_bound_norm_residual": { "type": "number", "const": 1.0 },
        "max_exact_residual_violations": { "type": "integer", "const": 0 },
        "min_acquisition_valid_runs": { "type": "integer", "minimum": 30 },
        "min_allowed_ci_lower_bound_norm_residual": { "type": "number", "const": -1.0 }
      }
    }
  }
}
